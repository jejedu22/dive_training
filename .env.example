DOMAIN=dive.localhost
POSTGRES_DB=dive
POSTGRES_USER=dive
POSTGRES_PASSWORD=change-me
APP_SECRET=change-me
JWT_PASSPHRASE=change-me

# Premier compte administrateur, créé automatiquement au démarrage s'il n'existe AUCUN utilisateur.
# Le modifier ensuite ne change pas le compte : utilisez « php bin/console app:admin:reset ».
# Attention : Docker Compose interprète « $ » (et « # » précédé d'un espace) ; mettez la valeur
# entre apostrophes si le mot de passe en contient, ex. ADMIN_PASSWORD='Pa$$w0rd#1'
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
ADMIN_NAME=Administrateur

# Fuseau horaire du club (heures des créneaux)
APP_TIMEZONE=Europe/Paris

# --- Votre Traefik existant ---
# Nom du réseau Docker auquel il est connecté (docker network ls)
TRAEFIK_NETWORK=web
# Nom de l'entrypoint HTTPS (web = HTTP seul)
TRAEFIK_ENTRYPOINT=websecure
# Nom du certificatesResolver défini dans la config de Traefik
CERT_RESOLVER=letsencrypt
