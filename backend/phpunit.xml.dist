<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" bootstrap="tests/bootstrap.php" colors="true" failOnWarning="true">
    <php>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="APP_SECRET" value="test"/>
        <env name="KERNEL_CLASS" value="App\Kernel"/>
        <env name="JWT_PASSPHRASE" value="test" force="true"/>
        <env name="DATABASE_URL" value="sqlite:///%kernel.project_dir%/var/test.db" force="true"/>
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="disabled"/>
    </php>
    <testsuites><testsuite name="all"><directory>tests</directory></testsuite></testsuites>
</phpunit>
